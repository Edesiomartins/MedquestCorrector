DATABASE_URL=postgresql://user:password@localhost/medquest_corrector
REDIS_URL=redis://localhost:6379/0

# Segredos (produção: usar gestor de secrets)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_FALLBACKS=dots-studio/dots-3-note-preview:free,google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=z-ai/glm-5.2:free
OPENROUTER_TEXT_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=medquestcorrector
OPENROUTER_TIMEOUT_SECONDS=90

# HTR V2 e importação de provas discursivas externas
HTR_BATCH_PAGE_ENABLED=false
HTR_BATCH_PAGE_MAX_QUESTIONS_PER_SHEET=8
DISCURSIVE_UNIVERSAL_IMPORT_ENABLED=false

OCR_PROVIDER=mistral,google_vision
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
GOOGLE_VISION_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads locais
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=40

# CSV de turmas
MAX_CSV_MB=5
MAX_CSV_ROWS=2000

# JWT
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
